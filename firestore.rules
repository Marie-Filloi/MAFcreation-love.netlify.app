rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{code} {
      allow read: if true;
      // Only the server (Stripe webhook, via firebase-admin) creates couple documents.
      allow create: if false;
      // Clients may only ever touch gameplay state and mood/name — never the code, email, or subscription status.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['state', 'partners', 'updatedAt']);
      allow delete: if false;
    }
  }
}
