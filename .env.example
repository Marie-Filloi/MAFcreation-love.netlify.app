# Paystack (dashboard Paystack > Settings > API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_test_...
# Le code du plan récurrent créé dans Paystack > Plans
PAYSTACK_PLAN_CODE=PLN_...

# Resend (resend.com > API Keys)
RESEND_API_KEY=re_...
# Adresse d'expédition des emails, doit venir d'un domaine vérifié sur Resend
EMAIL_FROM="Malgré la distance <bonjour@votredomaine.com>"

# Firebase (console Firebase > Paramètres du projet > Comptes de service > Générer une clé privée)
# Collez ici le JSON entier du fichier téléchargé, sur une seule ligne.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# URL publique du site déployé (sans slash final)
APP_BASE_URL=https://votresite.vercel.app
